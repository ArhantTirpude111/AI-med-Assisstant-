# =============================================================================
# MedIntel AI — environment configuration
# Copy to `.env` and fill in secrets.  Variables are prefixed MEDINTEL_ and use
# `__` as the nested-key delimiter (e.g. MEDINTEL_LLM__MODEL maps to llm.model).
# =============================================================================

# --- Secrets ---------------------------------------------------------------
# Only needed if MEDINTEL_LLM__PROVIDER=openai. Leave blank for free local mode.
OPENAI_API_KEY=

# --- LLM -------------------------------------------------------------------
# FREE OPTIONS (no OpenAI bill):
#   • provider=local  → small model on your CPU, no key, fully offline
#   • provider=openai + a free OpenAI-compatible host via BASE_URL (e.g. Groq):
#       MEDINTEL_LLM__BASE_URL=https://api.groq.com/openai/v1
#       MEDINTEL_LLM__MODEL=llama-3.3-70b-versatile
#       OPENAI_API_KEY=<your free Groq key>
MEDINTEL_LLM__PROVIDER=local           # openai | local | mock
MEDINTEL_LLM__MODEL=gpt-4o-mini
MEDINTEL_LLM__LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# MEDINTEL_LLM__BASE_URL=
MEDINTEL_LLM__TEMPERATURE=0.1
MEDINTEL_LLM__MAX_TOKENS=512
MEDINTEL_LLM__TIMEOUT_SECONDS=60

# --- Embeddings ------------------------------------------------------------
MEDINTEL_EMBEDDINGS__PROVIDER=openai   # openai | huggingface | hash
MEDINTEL_EMBEDDINGS__MODEL=text-embedding-3-small
MEDINTEL_EMBEDDINGS__HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEDINTEL_EMBEDDINGS__BATCH_SIZE=64

# --- Chunking --------------------------------------------------------------
MEDINTEL_CHUNKING__CHUNK_SIZE=900
MEDINTEL_CHUNKING__CHUNK_OVERLAP=150

# --- Retrieval / Guardrails ------------------------------------------------
MEDINTEL_RETRIEVAL__TOP_K=5
MEDINTEL_RETRIEVAL__FETCH_K=20
MEDINTEL_RETRIEVAL__MIN_CONFIDENCE=0.35
MEDINTEL_RETRIEVAL__MAX_CONTEXT_CHARS=8000

# --- OCR -------------------------------------------------------------------
MEDINTEL_OCR__ENABLED=true
MEDINTEL_OCR__LANGUAGE=eng
MEDINTEL_OCR__DPI=300
# MEDINTEL_OCR__TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Paths -----------------------------------------------------------------
MEDINTEL_PATHS__DATA_DIR=data
MEDINTEL_PATHS__UPLOAD_DIR=data/uploads
MEDINTEL_PATHS__INDEX_DIR=data/index
MEDINTEL_PATHS__DB_URL=sqlite:///data/medintel.db

# --- Observability ---------------------------------------------------------
MEDINTEL_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
MEDINTEL_LOG_JSON=false
